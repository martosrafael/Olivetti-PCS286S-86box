diff --git a/src/device/kbc_at.c b/src/device/kbc_at.c
index 80bd5a0c4..b7ad677db 100644
--- a/src/device/kbc_at.c
+++ b/src/device/kbc_at.c
@@ -2013,6 +2013,20 @@ write_cmd_olivetti(void *priv, uint8_t val)
             dev->p1 = ((dev->p1 + 1) & 3) | (dev->p1 & 0xfc);
             ret = 0;
             break;
+
+        case 0x82:
+        case 0x8a:
+        case 0x8b:
+            /* Seen during PCS 286S POST; appears to query the same status byte. */
+            kbc_delay_to_ob(dev, (0x0c | (is386 ? 0x00 : 0x80)) & 0xdf, 0, 0x00);
+            ret = 0;
+            break;
+
+        case 0xcf:
+            /* Seen during PCS 286S POST; report the controller self-test as OK. */
+            kbc_delay_to_ob(dev, 0x55, 0, 0x00);
+            ret = 0;
+            break;
     }
 
     return ret;
@@ -2758,6 +2772,9 @@ kbc_at_port_2_read(uint16_t port, void *priv)
 
     ret = dev->status;
 
+    if ((dev->flags & KBC_VEN_MASK) == KBC_VEN_OLIVETTI)
+        ret |= (STAT_SYSFLAG | STAT_UNLOCKED);
+
     kbc_at_log("ATkbc: [%04X:%08X] read (%04X) = %02X\n",  CS, cpu_state.pc, port, ret);
 
     return ret;
@@ -2813,6 +2830,11 @@ kbc_at_reset(void *priv)
 
     /* Stage 1. */
     dev->status = (dev->status & 0x0f) | (dev->p1 & 0xf0);
+
+    if ((dev->flags & KBC_VEN_MASK) == KBC_VEN_OLIVETTI) {
+        dev->status &= ~(STAT_PARITY | STAT_RTIMEOUT | STAT_TTIMEOUT | STAT_MFULL);
+        dev->status |= (STAT_SYSFLAG | STAT_UNLOCKED);
+    }
 }
 
 static void
