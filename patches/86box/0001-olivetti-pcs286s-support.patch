+static void
+olivetti_pcs286s_sync_cmos(void)
+{
+    nvr_t   *nvr = (nvr_t *) device_get_priv(machine_get_nvr_device(machine));
+    uint32_t base_kb;
+    uint32_t extended_kb;
+    uint16_t memory_banks;
+    uint8_t  memory_profile;
+    uint8_t  equipment;
+    uint16_t checksum = 0;
+    int      changed  = 0;
+
+    if (nvr == NULL)
+        return;
+
+    base_kb     = nvr->regs[0x15] | (nvr->regs[0x16] << 8);
+    extended_kb = nvr->regs[0x30] | (nvr->regs[0x31] << 8);
+
+    if ((base_kb + extended_kb) != mem_size)
+        return;
+
+    if ((nvr->regs[0x17] != (extended_kb & 0xff)) ||
+        (nvr->regs[0x18] != (extended_kb >> 8))) {
+        nvr->regs[0x17] = extended_kb & 0xff;
+        nvr->regs[0x18] = extended_kb >> 8;
+        changed = 1;
+    }
+
+    /* Memory above the first 768 KB of extended RAM is encoded in 16 KB banks. */
+    memory_banks = (extended_kb > 768) ? ((extended_kb - 768) >> 4) : 0;
+    if ((nvr->regs[0x20] != (memory_banks & 0xff)) ||
+        (nvr->regs[0x21] != (memory_banks >> 8))) {
+        nvr->regs[0x20] = memory_banks & 0xff;
+        nvr->regs[0x21] = memory_banks >> 8;
+        changed = 1;
+    }
+
+    memory_profile = 0x80 | (mem_size >> 9);
+    if (nvr->regs[0x24] != memory_profile) {
+        nvr->regs[0x24] = memory_profile;
+        changed = 1;
+    }
+
+    if (nvr->regs[0x34] || nvr->regs[0x35]) {
+        nvr->regs[0x34] = nvr->regs[0x35] = 0;
+        changed = 1;
+    }
+
+    equipment = (hasfpu ? 0x02 : 0x00) |
+                ((fdd_get_type(0) || fdd_get_type(1)) ? 0x01 : 0x00);
+    if ((nvr->regs[0x14] & 0x03) != equipment) {
+        nvr->regs[0x14] = (nvr->regs[0x14] & ~0x03) | equipment;
+        changed = 1;
+    }
+
+    if (nvr->regs[0x0e] & 0x30) {
+        nvr->regs[0x0e] &= ~0x30;
+        changed = 1;
+    }
+
+    if (changed) {
+        for (uint8_t i = 0x10; i <= 0x2d; i++)
+            checksum += nvr->regs[i];
+
+        nvr->regs[0x2e] = checksum >> 8;
+        nvr->regs[0x2f] = checksum & 0xff;
+        nvr_dosave       = 1;
+    }
+}
